# DriveWise Telematics Engine Environment Configuration

# Application Port & Mode
VITE_APP_PORT=3000
VITE_APP_ENV=development

# Telematics Ingestion API Endpoint
VITE_TELEMATICS_API_BASE_URL=https://api.drivewise.flegartech.com/v1

# Real-time WebSocket Gateway
VITE_TELEMATICS_WS_URL=wss://stream.drivewise.flegartech.com/telemetry

# Mapbox / OpenStreetMap Geolocation Token (Optional for visual routes)
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZmxlZ2FydGVjaCIsImEiOiJjbGV4YW1wbGV0b2tlbjEyMzQ1Njc4OTAifQ

# Telemetry Sampling Rate in Milliseconds (Default: 1000ms = 1Hz)
VITE_TELEMETRY_SAMPLING_RATE_MS=1000

# Strict Driving Algorithm Tuning
VITE_HARSH_BRAKE_THRESHOLD_G=0.35
VITE_HARSH_ACCEL_THRESHOLD_G=0.30
VITE_CORNERING_THRESHOLD_G=0.40
